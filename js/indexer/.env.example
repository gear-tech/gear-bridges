# Required: obtain this entire set from ONE verified bridge deployment.
# No public test network is selected implicitly. See README.md before starting.
GEAR_RPC_URL=
GEAR_ARCHIVE_URL=
GEAR_FROM_BLOCK=
GEAR_VFT_MANAGER=
GEAR_HISTORICAL_PROXY=
GEAR_BRIDGING_PAYMENT=
GEAR_CHECKPOINT_CLIENT=
GEAR_SQUID_API_KEY=
ETH_HTTP_RPC_URL=

# Keep this value when restarting an existing same-network deployment.
# A different network requires a separate database, not just a new cursor schema.
GEAR_STATE_SCHEMA=gear_processor
GEAR_API_PATH=./api/gear
GEAR_RATE_LIMIT=100

# Set both connection forms to the SAME database (used by different components).
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Configure the paired Ethereum processor explicitly as part of the same deployment.
ETH_RPC_URL=
ETH_ARCHIVE_URL=
ETH_FROM_BLOCK=
ETH_ERC20_MANAGER=
ETH_MSQ_QUEUE=
ETH_BRIDGING_PAYMENT=
ETH_SQUID_API_KEY=
ETH_API_PATH=./api/ethereum
