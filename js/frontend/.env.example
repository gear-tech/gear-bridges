# vara network
VITE_VARA_NODE_ADDRESSES=

# eth network
VITE_ETH_NODE_ADDRESSES=
VITE_ETH_CHAIN_IDS=
VITE_WALLET_CONNECT_PROJECT_ID=

# txs history
VITE_INDEXER_ADDRESSES=

# vara swap
VITE_BRIDGING_PAYMENT_CONTRACT_ADDRESSES=
VITE_VFT_MANAGER_CONTRACT_ADDRESSES=

# eth swap
VITE_ETH_BRIDGING_PAYMENT_CONTRACT_ADDRESSES=
VITE_ERC20_MANAGER_CONTRACT_ADDRESSES=

# token prices
VITE_TOKEN_PRICE_API_URL=

# Independently approved, different HTTPS deployment origins. No paths/trailing slash.
VITE_FUNDS_ORIGIN=
VITE_FAUCET_ORIGIN=
# Required JSON array of exact approved HTTPS/WSS RPC, Beacon, indexer, wallet,
# price and error-reporting origins. Never generated from indexer/API responses.
BRIDGE_CSP_CONNECT_ORIGINS=
# Enable only after browser evidence proves WASM startup needs this permission.
BRIDGE_CSP_WASM_EVAL=false
#
# Separate faucet build ONLY. isolated mode uses the existing /faucet/* service.
VITE_ISOLATED_FAUCET=false
VITE_TURNSTILE_SITEKEY=
VITE_TURNSTILE_HOSTNAME=
# Public mode: independently approved {genesis, tokens:[{name,address}]} JSON.
# Tokens are exact test ERC20 identities, never selected by ticker substring.
VITE_FAUCET_PROFILE=
# Node-side public payout service upstream; nginx strips /faucet/ before forwarding.
# Never a second service or new signer. Isolated mode always uses 127.0.0.1:5485.
BRIDGE_FAUCET_PUBLIC_UPSTREAM=

# manual relay
VITE_VARA_ARCHIVE_NODE_ADDRESSES=
VITE_ETH_BEACON_NODE_ADDRESSES=
VITE_ETH_MESSAGE_QUEUE_CONTRACT_ADDRESSES=

# independently approved MAINNET/TESTNET InboundProofProfile JSON; absent/unknown stays HOLD
# ethereumChainId/beaconGenesisTime/fork epochs use decimal strings, not unlabeled artifact hashes
VITE_INBOUND_PROOF_PROFILES=

# Optional approved local-consensus fixture descriptor JSON (chain 31337); leave unset for Hoodi/mainnet
VITE_OWNED_FIXTURE_NETWORK=

# Optional Node-side Vite development/preview GraphQL proxy, never exposed to the browser
BRIDGE_INDEXER_PROXY=

VITE_SENTRY_DSN=
